# Copy to /opt/chess_teacher/infra/postgres.env on the VPS (do not commit).
#
# This file configures the Postgres *container* (docker compose), not app clients.
# There is no POSTGRES_HOST here: the server listens on the VPS; clients (app / psql)
# get host from Doppler as POSTGRES_HOST=<node-ip>.
#
# USER and DB must match Doppler prod exactly:
#   doppler secrets get POSTGRES_USER --project chess-teacher --config prod --plain
#   doppler secrets get POSTGRES_DB   --project chess-teacher --config prod --plain

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-to-a-strong-secret
POSTGRES_DB=postgres
POSTGRES_PORT=5432

# Host bind-mount for PGDATA
POSTGRES_DATA_DIR=/var/lib/chess_teacher/postgres

# Tune after checking `free -m` on the VPS (defaults suit a small shared box).
POSTGRES_SHARED_BUFFERS=256MB
POSTGRES_MAX_CONNECTIONS=100
