# Reference for Doppler config dev_local (copy keys/values into the Doppler dashboard).
# Do not commit a real .env — secrets live in Doppler (configs: dev_local, dev_k3d, ci, prod).
#
# dev_k3d: same as dev_local but:
#   POSTGRES_HOST=host.k3d.internal
#   S3_ENDPOINT_URL=http://host.k3d.internal:9000
#   REDIS_URL=redis://host.k3d.internal:6379/0

APP_PORT=8502
ENVIRONMENT=DEV

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=chess_teacher
POSTGRES_USER=chess_teacher
POSTGRES_PASSWORD=change-me
POSTGRES_SSLMODE=

S3_BUCKET=chess-teacher
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
STORAGE_ROOT=chess-teacher

REDIS_URL=redis://localhost:6379/0
LOG_BUFFER_DIR=./storage/log-buffer
LOG_SHIP_ENABLED=false

# MLflow (baseline training). Artifacts use existing S3_* under STORAGE_ROOT/mlflow.
MLFLOW_TRACKING_URI=file:./storage/mlflow/tracking
MLFLOW_EXPERIMENT_NAME=baseline
# Optional override; default derived as s3://{S3_BUCKET}/{STORAGE_ROOT}/mlflow
# MLFLOW_ARTIFACT_ROOT=
MIN_NEW_MOVES_BASELINE=1000

DOCKERHUB_USERNAME=your-dockerhub-user

STREAMLIT_REDIRECT_URI=http://localhost:8502/oauth2callback
STREAMLIT_COOKIE_SECRET=change-me
STREAMLIT_GOOGLE_CLIENT_ID=change-me.apps.googleusercontent.com
STREAMLIT_GOOGLE_CLIENT_SECRET=change-me
